# Copy to .env. Never commit the real file.
ANTHROPIC_API_KEY=
DISCORD_TOKEN=

# Optional. Only if your OneBot server (NapCat) has an access token set.
ONEBOT_TOKEN=

# Optional. Sign-in token for the web UI, at least 16 characters. If empty, a new one is printed at each startup.
AKANEBOT_WEB_TOKEN=

# Optional. Any IANA time zone; overrides the persona file. Daylight saving is handled automatically.
AKANEBOT_TIMEZONE=America/Toronto
