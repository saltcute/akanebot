{
  "name": "gabriel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "explain": "node --disable-warning=ExperimentalWarning src/cli/explain.ts",
    "sim": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/sim.ts",
    "memory": "node --disable-warning=ExperimentalWarning src/cli/memory.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@huggingface/transformers": "^4.3.2",
    "discord.js": "^14.28.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
